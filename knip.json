{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/TownStage.tsx",
    "functions/api/**/*.ts",
    "next.config.ts",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "scripts/*.mjs"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.ts",
    "lib/**/*.{ts,mts,mjs}",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": ["tailwindcss", "prettier"],
  "ignore": ["functions/api/**/*.ts"]
}
