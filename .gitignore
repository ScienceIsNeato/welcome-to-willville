# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/output/

# production
/build

# misc
.DS_Store
*.pem

# local dev secrets
.dev.vars

# wrangler dev artifacts
.wrangler/

# Python venv
.venv/

# temp files
.tmp/

# local repaint trail
/data/backups/
/data/town-site-appearance-audit.v1.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.cursor

# Generated Copilot instructions (from cursor-rules)
.github/instructions/*.instructions.md

# Agent/session runtime locks
.claude/
.clinerules/
.roo/
.windsurf/
.vscode/
.aider.conf.yml
.claude/*.lock
.specstory/

# slop-mop working directory (machine-local state) — but track the committed
# dependency manifest the v2 Action installs from.
.slopmop/*
!.slopmop/required-deps.json

# perf test tooling (playwright, installed on first run)
.perf-tools/

# perf baseline (machine-specific, use --save-baseline to create)
.perf-baseline.json

# Local cursor-rules clone (separate git repo)
/cursor-rules/
