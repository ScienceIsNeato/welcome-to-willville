#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit hook: if STATUS.md is staged, .willville.json must be too
#
# The packet should reflect what you just wrote in STATUS.md. If you're
# updating your status log, update the town map status at the same time.
# ─────────────────────────────────────────────────────────────────────────────

# Skip during rebase/merge
[[ -d .git/rebase-merge ]] || [[ -d .git/rebase-apply ]] && exit 0
[[ -f .git/MERGE_HEAD ]] && exit 0

# Mirror slop-mop's pattern: run a focused guard script and block on non-zero.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
bash "$HOOK_DIR/../scripts/check-willville-freshness.sh" || exit 1

# Is STATUS.md being committed?
if git diff --cached --name-only | grep -qx "STATUS.md"; then
  # Is .willville.json also being committed?
  if ! git diff --cached --name-only | grep -qx ".willville.json"; then
    echo ""
    echo "  STATUS.md is staged but .willville.json is not."
    echo ""
    echo "  Update the packet so the town map reflects your status."
    echo "  Just update status and direction in .willville.json — keep it"
    echo "  plain and casual, like a standup update."
    echo ""
    echo "  Then:  git add .willville.json"
    echo ""
    exit 1
  fi
fi
