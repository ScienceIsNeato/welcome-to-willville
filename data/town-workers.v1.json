        { "id": "outbound", "from": 0, "to": 0.44, "animation": "bucket" },
        { "id": "mopping", "from": 0.44, "to": 0.56, "animation": "sweep" },
        { "id": "return", "from": 0.56, "to": 1, "animation": "walk" }
      ]
    }
  ]
}
