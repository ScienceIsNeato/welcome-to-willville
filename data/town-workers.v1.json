{
  "version": "town-workers-v1",
  "animatedArt": [
    {
      "id": "mop-worker",
      "src": "/art/sprites/mop-worker.png",
      "sheetWidth": 384,
      "sheetHeight": 192,
      "frameWidth": 48,
      "frameHeight": 48,
      "visualScale": 0.55,
      "animations": {
        "walk": { "row": 0, "frames": 8, "fps": 10 },
        "sweep": { "row": 1, "frames": 8, "fps": 12 },
        "idle": { "row": 2, "frames": 4, "fps": 6 },
        "bucket": { "row": 3, "frames": 8, "fps": 10 }
      }
    }
  ],
  "staticArt": [],
  "systems": [
    {
      "id": "mop-service",
      "kind": "mop",
      "homeSiteId": "slop-mop",
      "homeLandmark": "slopDepot",
