{
  "version": "town-animation-v1",
  "sprites": [
    {
      "id": "mop-worker",
      "src": "/art/sprites/mop-worker.png",
      "sheetWidth": 384,
      "sheetHeight": 192,
      "frameWidth": 48,
      "frameHeight": 48,
      "animations": {
        "walk": { "row": 0, "frames": 8, "fps": 10 },
        "sweep": { "row": 1, "frames": 8, "fps": 12 },
        "idle": { "row": 2, "frames": 4, "fps": 6 },
        "bucket": { "row": 3, "frames": 8, "fps": 10 }
      }
    }
  ],
  "systems": [
    {
      "id": "mop-service",
      "originLandmark": "slopDepot",
      "sprite": "mop-worker",
      "routeStrategy": "slop-depot-to-site",
      "maxAgents": 33,
      "secondsPerRoute": 42,
      "frameSeconds": 0.9,
      "routeStates": [
        { "id": "outbound", "from": 0, "to": 0.44, "animation": "bucket" },
        { "id": "mopping", "from": 0.44, "to": 0.56, "animation": "sweep" },
        { "id": "return", "from": 0.56, "to": 1, "animation": "walk" }
      ]
    }
  ]
}
