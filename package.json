{
  "name": "welcome-to-willville",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "next dev -p 3736",
    "dev:cf": "wrangler pages dev --proxy 3736 --port 3737 --compatibility-date 2026-05-01",
    "build": "next build",
    "type-check": "tsc --noEmit",
    "start": "next start",
    "populate": "node scripts/populate-manifests.mjs",
    "town:validate": "node scripts/validate-town-layout.mjs",
    "town:masks": "node scripts/validate-town-layout.mjs && node scripts/generate-town-mask-contract.mjs",
    "town:base-art": "node scripts/generate-town-base-art.mjs",
    "town:district-art-placeholders": "node scripts/generate-town-district-art-placeholders.mjs",
    "town:world-art": "node scripts/generate-town-world-backdrop.mjs",
    "town:mop-sprite": "node scripts/generate-mop-worker-sprite.mjs",
    "town:site-sprites": "node scripts/generate-town-site-sprites.mjs",
    "town:region-prompts": "node scripts/generate-town-region-art-prompts.mjs",
    "town:district-art-kits": "node scripts/generate-town-district-art-kits.mjs",
    "town:apply-district-art": "node scripts/apply-town-district-art.mjs",
    "town:apply-world-landscape-art": "node scripts/apply-town-world-landscape-art.mjs",
    "town:preview": "node scripts/validate-town-layout.mjs && node scripts/generate-town-layout-preview.mjs && node scripts/generate-town-mask-contract.mjs && node scripts/generate-town-district-art-kits.mjs && node scripts/generate-town-region-art-prompts.mjs && node scripts/generate-town-base-art.mjs && node scripts/generate-town-district-art-placeholders.mjs && node scripts/generate-town-world-backdrop.mjs && node scripts/generate-mop-worker-sprite.mjs && node scripts/generate-town-site-sprites.mjs",
    "town:art-brief": "node scripts/generate-town-art-brief.mjs && node scripts/generate-town-district-art-kits.mjs && node scripts/generate-town-region-art-prompts.mjs"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "framer-motion": "^12.39.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  }
}
